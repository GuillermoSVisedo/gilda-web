# Copia este archivo como .env.local (NUNCA subas .env.local al repositorio,
# ya está excluido en .gitignore) y rellena el valor real.

# Token de acceso a la API de Loyverse.
# Se genera en el panel de Loyverse: Ajustes > Acceso a la API.
LOYVERSE_API_TOKEN=

# Cuenta de Cloudinary (gratis) donde se guardan las fotos adicionales de
# producto que no caben en Loyverse (solo admite 1 foto por artículo).
# Dashboard de Cloudinary > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contraseña del panel privado /admin (gestión de fotos de producto).
# Invéntate una — no uses fechas ni datos adivinables.
ADMIN_PASSWORD=
